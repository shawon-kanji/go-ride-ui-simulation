# Browser Maps key (Maps JavaScript + Directions + Routes), restricted to localhost referrers.
VITE_GOOGLE_MAPS_API_KEY=your-browser-maps-key

# Dev-server proxy targets (read by vite.config.ts only — never shipped to the browser).
# Defaults match the local ports used by scripts/run-all.sh.
PROXY_BACKEND=http://localhost:8080
PROXY_LOCATION=http://localhost:8081
PROXY_CAB=http://localhost:8082
PROXY_WS=http://localhost:8083
PROXY_DRIVER_TRIPS=http://localhost:8084
